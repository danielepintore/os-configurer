#!/usr/bin/env bash

# system utils
yay -S noctalia-greeter btrfs-assistant

# configure noctalia greeter
sudo sed -i 's#^command\s*=.*#command = "'$(command -v noctalia-greeter-session)'"#' /etc/greetd/config.toml
sudo systemctl enable --now greetd
sudo noctalia-greeter passwordless-sync enable $USER
# disable noctalia greeter logo
echo -e "[appearance]\nhide_logo = true" | sudo tee -a /var/lib/noctalia-greeter/greeter.toml > /dev/null

# nautilus open any terminal with wezterm
yay -S nautilus-open-any-terminal
gsettings set com.github.stunkymonkey.nautilus-open-any-terminal terminal wezterm

# user packages
yay -S android-apktool anytype-bin burpsuite cura-bin dex2jar ente-auth-bin \
	httpie-desktop-bin jdownloader2 lrcget-bin qdirstat teams-for-linux termius \
	vdhcoapp-bin wezterm-nightly-bin
